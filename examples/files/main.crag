// Reads a text file and prints it with its lines numbered, telling what
// went wrong when it cannot. Run it as `crag run [file]`; without a file
// it prints `poem.txt`.

import std.env
import std.io

// The lines of a text, each after its number, the numbers right-aligned.
pub fn numbered(text: Str) -> List[Str] {
  let lines = text.lines()
  let width = "{lines.count()}".codePointCount()
  lines.indexed().map { l -> "{"{l.index + 1}".padStart(width)}  {l.value}" }
}

fn main() -> ExitCode {
  let path = case args() {
    given: List[Str] -> given.first().orElse("poem.txt")
    _ -> "poem.txt"
  }
  case readText(path) {
    text: Str -> {
      for line in numbered(text) { printLine(line) }
      ExitCode(code: 0)
    }
    e: IoError -> {
      printLine("cannot read {path}: error {e.code}")
      ExitCode(code: 1)
    }
    e: NotUtf8 -> {
      printLine("{path} is not UTF-8 text")
      ExitCode(code: 1)
    }
  }
}
