// The C-level types of the foreign function interface (Specification
// §16.1). The integer types are aliases of the sized integers; `CF32`,
// `CPtr` and `COut` are the compiler's, and a `CStr` holds its bytes and
// the NUL after them.

pub type CChar = Int8
pub type CUChar = UInt8
pub type CShort = Int16
pub type CUShort = UInt16
pub type CInt = Int32
pub type CUInt = UInt32
pub type CLong = Int
pub type CULong = UInt64
pub type CSize = UInt64
pub type CF64 = Float

pub type CF32
pub type CPtr[T]
pub type COut[T]

pub opaque type CStr(bytes: Bytes)

// The greatest finite 32-bit float.
let cf32Max = 3.4028234663852886e38

// The `Float`, or the tag of a NaN or an infinity (§3.1.4), read from
// the bits: the sign is the top bit, and a NaN's magnitude is above the
// infinity's.
pub fn convert(x: CF32) -> Float | NonFinite {
  let bits = cf32Bits(x)
  let magnitude = if bits >= 2147483648 { bits - 2147483648 } else { bits }
  if magnitude > 2139095040 { return NaN }
  if magnitude == 2139095040 {
    if bits == magnitude { return PosInfinity }
    return NegInfinity
  }
  bytes([0, 0, 0, 0]).writeUInt32(0, bits, Little).readFloat32(0, Little).orElse(0.0)
}

pub fn convert(f: Float) -> CF32 | Unconvertible {
  if f > cf32Max or f < -cf32Max { return Unconvertible }
  let raw = bytes([0, 0, 0, 0]).writeFloat32(0, f, Little)
  cf32Of(raw.readUInt32(0, Little).orElse(0))
}

pub fn isNull[T](p: CPtr[T]) -> Bool { ptrWord(p) == 0 }

// A copy of the string with a NUL after it, unless it holds one.
pub fn convert(s: Str) -> CStr | Unconvertible {
  if s.contains("\0") { return Unconvertible }
  CStr(bytes: s.bytes() + bytes([0]))
}

pub fn convert(c: CStr) -> Str | NotUtf8 { c.bytes.slice(0..c.bytes.count() - 2).text() }

fn cf32Bits(x: CF32) -> UInt32
fn cf32Of(bits: UInt32) -> CF32
fn ptrWord[T](p: CPtr[T]) -> UInt64
