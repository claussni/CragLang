// The process's own context (Specification §19.7): its arguments, the
// environment's variables and the platform. All but the platform are
// effects.

// The program's arguments, without its name.
pub fn rawArgs() -> List[Bytes] { envArgs() }

pub fn args() -> List[Str] | NotUtf8 {
  var out: List[Str] = []
  for arg in envArgs() {
    case arg.text() {
      s: Str -> { out = out.append(s) }
      e: NotUtf8 -> { return e }
    }
  }
  out
}

// The value of an environment variable, if it is set.
pub fn env(name: Str) -> Option[Str] | NotUtf8 {
  if envVar(name) == 0 { return Empty }
  let value: Bytes = envVarBytes()
  value.text()
}

// The variables whose names and values are UTF-8.
pub fn vars() -> Map[Str, Str] { envVars() }

pub type Linux
pub type MacOs
pub type Windows
pub type FreeBsd
pub type Os = Linux | MacOs | Windows | FreeBsd

pub type X64
pub type Arm64
pub type Arch = X64 | Arm64

// The system and the processor the program runs on.
pub fn os() -> Os {
  let code = envPlatform(0)
  if code == 1 { return MacOs }
  if code == 2 { return Windows }
  if code == 3 { return FreeBsd }
  Linux
}

pub fn arch() -> Arch {
  if envPlatform(1) == 1 { return Arm64 }
  X64
}

fn envArgs() -> List[Bytes]
fn envVar(name: Str) -> Int
fn envVarBytes() -> Bytes
fn envVars() -> Map[Str, Str]
fn envPlatform(which: Int) -> Int
