// The prelude (Specification §19.3), as far as M1 reaches. The types without
// a body are the compiler's built-in types, and the functions without a
// body are operations it generates inline. The operators of `Fixed` wait for
// generic functions.

pub type Int
pub type Int8
pub type Int16
pub type Int32
pub type UInt8
pub type UInt16
pub type UInt32
pub type UInt64
pub type Float
pub type Fixed[S]
pub type CodePoint
pub type Str
pub type Bytes
pub type List[T]
pub type Map[K, V]
pub type Set[T]
pub type Grid[T]
pub type Lazy[T]

pub type True
pub type False
pub type Bool = True | False
pub type Empty[T]
pub type Option[T] = T | Empty[T]
pub type Less
pub type Equal
pub type Greater
pub type Ordering = Less | Equal | Greater

// The parent of every error type (§8.1).
pub distinct type Error

// The type functions of error unions and the type mapping functions over
// them (§8.4).
pub type Oks[X]
pub type Errs[X]
pub fn discard[X](x: X) -> () | Errs[X] prefix "~"
pub fn check[X](x: X) -> Option[Oks[X]] prefix "?"
pub fn expect[X](x: X) -> Oks[X] prefix "!!"

pub type Range[T](first: T, last: T)
pub type RangeFrom[T](first: T)

// What `main` may return for the exit status (§19.7.1).
pub type ExitCode(code: Int) where code >= 0 and code <= 255

// Int

pub fn add(a: Int, b: Int) -> Int
pub fn subtract(a: Int, b: Int) -> Int
pub fn multiply(a: Int, b: Int) -> Int
pub fn divide(a: Int, b: Int) -> Int
pub fn remainder(a: Int, b: Int) -> Int
pub fn addWrapping(a: Int, b: Int) -> Int
pub fn subtractWrapping(a: Int, b: Int) -> Int
pub fn multiplyWrapping(a: Int, b: Int) -> Int
pub fn negate(a: Int) -> Int
pub fn equals(a: Int, b: Int) -> Bool
pub fn lessThan(a: Int, b: Int) -> Bool
pub fn lessOrEqual(a: Int, b: Int) -> Bool
pub fn greaterThan(a: Int, b: Int) -> Bool
pub fn greaterOrEqual(a: Int, b: Int) -> Bool

// Int8

pub fn add(a: Int8, b: Int8) -> Int8
pub fn subtract(a: Int8, b: Int8) -> Int8
pub fn multiply(a: Int8, b: Int8) -> Int8
pub fn divide(a: Int8, b: Int8) -> Int8
pub fn remainder(a: Int8, b: Int8) -> Int8
pub fn addWrapping(a: Int8, b: Int8) -> Int8
pub fn subtractWrapping(a: Int8, b: Int8) -> Int8
pub fn multiplyWrapping(a: Int8, b: Int8) -> Int8
pub fn negate(a: Int8) -> Int8
pub fn equals(a: Int8, b: Int8) -> Bool
pub fn lessThan(a: Int8, b: Int8) -> Bool
pub fn lessOrEqual(a: Int8, b: Int8) -> Bool
pub fn greaterThan(a: Int8, b: Int8) -> Bool
pub fn greaterOrEqual(a: Int8, b: Int8) -> Bool

