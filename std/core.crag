// CodePoint
pub fn equals(a: CodePoint, b: CodePoint) -> Bool
pub fn lessThan(a: CodePoint, b: CodePoint) -> Bool
pub fn lessOrEqual(a: CodePoint, b: CodePoint) -> Bool
pub fn greaterThan(a: CodePoint, b: CodePoint) -> Bool
