// The prelude (Specification §19.3), as far as M1 reaches. The types without
// a body are the compiler's built-in types, and the functions without a
// body are operations it generates inline. The operators of `Fixed` wait for
// generic functions.

pub type Int
pub type Int8
pub type Int16
pub type Int32
pub type UInt8
pub type UInt16
pub type UInt32
pub type UInt64
pub type Float
pub type Fixed[S]
pub type CodePoint
pub type Str
pub type Bytes
pub type List[T]
pub type Map[K, V]
pub type Set[T]
pub type Grid[T]
pub type Lazy[T]
// The value of a lazy expression, computed by the first read (§6.10).
pub fn value[T](l: Lazy[T]) -> T

pub type True
pub type False
pub type Bool = True | False
pub type Empty[T]
pub type Option[T] = T | Empty[T]

// The function of the value, or `Empty` (Specification §3.6).
pub fn then[T, U](o: Option[T], f: (T) -> U) -> Option[U] {
  case o {
    e: Empty[T] -> Empty
    x: T -> f(x)
  }
}

// The value, or the fallback for `Empty`.
pub fn orElse[T](o: Option[T], fallback: T) -> T {
  case o {
    e: Empty[T] -> fallback
    x: T -> x
  }
}

pub type Less
pub type Equal
pub type Greater
pub type Ordering = Less | Equal | Greater

// The parent of every error type (§8.1).
pub distinct type Error

// Lifecycle handlers (§11.4): the parent of their kinds, and the kinds the
// compiler runs so far.
pub distinct type LifecycleHandler
pub distinct type Dispose[T](..LifecycleHandler) where HandlerForm[(T) -> ()]

pub distinct type Embed[T](..LifecycleHandler)
  where HandlerForm[((Bytes) -> T | EmbedError) | ((Str) -> T | EmbedError), is Pure]

// A resource an `embed` handler cannot turn into a value: a compile error
// at the `embed`, at the line and column of the resource, when not zero
// (§18.4.1).
pub type EmbedError(..Error, message: Str, line: Int = 0, column: Int = 0)

// The type functions of error unions and the type mapping functions over
// them (§8.4).
pub type Oks[X]
pub type Errs[X]
pub fn discard[X](x: X) -> () | Errs[X] prefix "~"
pub fn check[X](x: X) -> Option[Oks[X]] prefix "?"
pub fn expect[X](x: X) -> Oks[X] prefix "!!"

// Shared state (§9): the refs of `ref` and the locking refs of `ext`, with
// their access functions, which pass closures (§9.3).
pub type Ref[T]
pub type Ext[T]
pub fn use[T](r: Ref[T]) -> T
pub fn use[T, U](r: Ref[T], f: (T) -> U) -> U
pub fn update[T, R](r: Ref[T], f: (T) -> R) -> () | Errs[R]
pub fn swap[T](r: Ref[T], new: T) -> T
pub fn empty[T](r: Ref[Option[T]]) -> Option[T]
pub fn use[T](r: Ext[T]) -> T
pub fn use[T, U](r: Ext[T], f: (T) -> U) -> U
pub fn update[T, R](r: Ext[T], f: (T) -> R) -> () | Errs[R]
pub fn swap[T](r: Ext[T], new: T) -> T
pub fn empty[T](r: Ext[Option[T]]) -> Option[T]

// The parent of every signal type (§11.1).
pub distinct type Signal

pub type Range[T](first: T, last: T)
pub type RangeFrom[T](first: T)

// What `main` may return for the exit status (§19.7.1).
pub type ExitCode(code: Int) where code >= 0 and code <= 255

// Forms (Specification §19.11)

pub form Eq[T] {
  equals(a: T, b: T) -> Bool
}

pub form Ordered[T] {
  compare(a: T, b: T) -> Ordering
}

pub form Hash[T] {
  hash(x: T) -> Int
}

pub form Show[T] {
  show(x: T) -> Str
}

// Every value is equal, ordered, hashed and shown by its structure, unless
// its type has a function of its own, which is more specific.
pub fn equals[T](a: T, b: T) -> Bool { valueEquals(a, b) == 1 }

pub fn compare[T](a: T, b: T) -> Ordering {
  let n = valueCompare(a, b)
  if n == 3 { trapUnordered() }
  ordering(n)
}

pub fn hash[T](x: T) -> Int { valueHash(x) }
pub fn show[T](x: T) -> Str { valueShow(x) }

pub fn lessThan[T: Ordered](a: T, b: T) -> Bool { compare(a, b) is Less }
pub fn lessOrEqual[T: Ordered](a: T, b: T) -> Bool { not (compare(a, b) is Greater) }
pub fn greaterThan[T: Ordered](a: T, b: T) -> Bool { compare(a, b) is Greater }
pub fn greaterOrEqual[T: Ordered](a: T, b: T) -> Bool { not (compare(a, b) is Less) }

fn valueEquals[T](a: T, b: T) -> Int
fn valueCompare[T](a: T, b: T) -> Int
fn valueHash[T](x: T) -> Int
fn valueShow[T](x: T) -> Str
fn trapUnordered() -> ()

