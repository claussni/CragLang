// Time (Specification §19.5), as far as M4 reaches: durations and sleep.

// A signed span in nanoseconds.
pub opaque type Duration(ns: Int)

pub fn nanos(n: Int) -> Duration { Duration(ns: n) }
pub fn millis(n: Int) -> Duration { Duration(ns: n * 1000000) }
pub fn seconds(n: Int) -> Duration { Duration(ns: n * 1000000000) }
pub fn minutes(n: Int) -> Duration { seconds(n * 60) }
pub fn hours(n: Int) -> Duration { minutes(n * 60) }

// Spans compare by their length; being opaque, they derive nothing
// outside this module.
pub fn equals(a: Duration, b: Duration) -> Bool { a.ns == b.ns }
pub fn compare(a: Duration, b: Duration) -> Ordering { compare(a.ns, b.ns) }
pub fn hash(d: Duration) -> Int { hash(d.ns) }

// Suspends the current task for `d`, at once for a span of zero or less.
// A cancelled task stops here (§10.4).
pub fn sleep(d: Duration) -> () {
  if d.ns > 0 { sleepNanos(d.ns) }
}

// The runtime's sleep (Implementation Plan §11.7.2).
fn sleepNanos(ns: Int) -> ()
